#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

bool solution(const char* s) {
    int length = strlen(s);
    int checker = 0;
    bool answer = true;
    
    for(int i = 0; i < length; i++){
        if(s[i] == '('){
            checker++;
        }
        else if (s[i] == ')'){
            checker--;
        }
        
        if(checker == -1){
            answer = false;
            break;
        }
    }
    
    if(checker != 0) {
        answer = false;
    }
    
    return answer;
}
