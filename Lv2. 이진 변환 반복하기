#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

int* solution(const char* s) {
    int* answer = (int*)malloc(sizeof(int) * 2);
    
    int startlength = strlen(s);
    char* startArr = (char*)malloc(sizeof(char) * startlength + 1);
    strcpy(startArr, s);
    
    int removeNum = 0;
    int loopNum = 0;
    
    while(true) {
        int length = strlen(startArr);
        int count1 = 0;
        int count0 = 0;
        
        for(int i = 0; i < length; i++){
            if(startArr[i] == '1'){
                count1++;
            }
            else {
                count0++;
            }
        }
        
        removeNum += count0;
        loopNum++;
        
        if(count1 == 1){
            break;
        }
        
        int check = 0;
        int checker = count1;
        while(true) {
            checker /= 2;
            check++;
            
            if(checker == 0){
                break;
            }
        }
        
        char* nextArr = (char*)malloc(sizeof(char) * check + 1);
        nextArr[check] = '\0';
        
        for(int i = 0; i < check; i++){
            int num = count1 % 2;
            count1 /= 2;
            
            nextArr[check - i - 1] = num + '0';
        }
        
        strcpy(startArr, nextArr);
        free(nextArr);
    }
    
    answer[0] = loopNum;
    answer[1] = removeNum;
    free(startArr);
    
    return answer;
}
