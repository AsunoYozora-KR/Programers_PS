#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

int comp1(const void *a, const void *b){
    return (*(int*)a - *(int*)b);
}

int comp2(const void *a, const void *b){
    return (*(int*)b - *(int*)a);
}

int solution(int A[], size_t A_len, int B[], size_t B_len) {
    qsort(A, A_len, sizeof(int), comp1);
    qsort(B, B_len, sizeof(int), comp2);
    
    int sum = 0;
    
    for(int i = 0; i < A_len; i++){
        sum += A[i] * B[i];
    }
    
    return sum;
}
